  },
  "dependencies": {
    "@instantlead/config": "workspace:*",
    "@instantlead/core": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "~0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11"
  }
}

{
  "name": "@instantlead/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env src/system/seed.ts",
    "secrets:rotate": "node --env-file-if-exists=../../.env src/system/rotate-secrets.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@instantlead/config": "workspace:*",
    "@instantlead/core": "workspace:*",
    "@instantlead/integrations": "workspace:*",
    "@sentry/node": "^11.2.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "~0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11",
    "embedded-postgres": "16.14.0-beta.17"
  }
}

{
  "name": "instantlead",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "pnpm --filter @instantlead/api dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/dashboard/tsconfig.json",
    "test": "vitest run",
    "test:fast": "vitest run --project unit --project api",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @instantlead/api db:generate",
    "db:migrate": "pnpm --filter @instantlead/api db:migrate",
    "db:seed": "pnpm --filter @instantlead/api db:seed",
    "templates:doc": "node packages/config/src/templates-doc.ts",
    "db:local": "node --env-file-if-exists=.env apps/api/test/dev-db.ts",
    "sim": "node --env-file-if-exists=.env packages/sim/src/cli.ts",
    "dev:dashboard": "pnpm --filter @instantlead/dashboard dev",
    "build": "pnpm --filter @instantlead/dashboard build",
    "secrets:rotate": "pnpm --filter @instantlead/api secrets:rotate",
    "demo": "node --env-file-if-exists=.env packages/sim/src/demo.ts",
    "loadtest": "node --env-file-if-exists=.env packages/sim/src/loadtest.ts",
    "e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}

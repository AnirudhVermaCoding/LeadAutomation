# Copy to .env (cp .env.example .env). Dev-only values: the app refuses to start
# with them when NODE_ENV=production.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL=http://localhost:3000

# Postgres from docker-compose. The owner runs migrations and pre-tenant lookups;
# the app connects as instantlead_app, which row-level security applies to.
POSTGRES_PASSWORD=instantlead_dev
DATABASE_OWNER_URL=postgres://instantlead:instantlead_dev@localhost:5432/instantlead
APP_DB_PASSWORD=app_dev_pw
DATABASE_URL=postgres://instantlead_app:app_dev_pw@localhost:5432/instantlead

# Generate real ones with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=dev-only-auth-secret-change-me-0000000000
SECRETS_KEY=ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE=

# pnpm db:seed creates these (dev only).
AGENCY_ADMIN_EMAIL=agency@instantlead.test
AGENCY_ADMIN_PASSWORD=dev-agency-password
SEED_PASSWORD=dev-demo-password

# api = HTTP only, worker = background jobs only, all = both.
ROLE=all
# Tenants without WhatsApp credentials use a fake channel (default: on outside production).
# ALLOW_FAKE_CHANNEL=true

# Meta app that receives WhatsApp + Lead Ads webhooks at <APP_URL>/webhooks/meta (optional in mock mode).
# META_APP_SECRET=
# META_VERIFY_TOKEN=

# Claude API key for the WhatsApp assistant. Without it (in mock mode) a rule-based fake assistant answers.
# Per-lead LLM spend ceiling in USD; above it the conversation is handed to staff.
# LLM_COST_CAP_USD_PER_LEAD=0.5

# Email (staff alerts, reports) via Resend. Mock mode records emails in memory instead.
# RESEND_API_KEY=
# EMAIL_FROM=InstantLead <alerts@yourdomain.com>
# Google OAuth client for the optional one-way Google Calendar sync
# (redirect URI: <APP_URL>/v1/integrations/google/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Operational alerts (failed sends, silent webhooks, AI errors, dead jobs) are emailed here.
# ALERT_EMAIL=you@youragency.com

# Production only (see docs/OPERATIONS.md):
# TRUST_PROXY=true            # behind Caddy
# HASH_KEY=                   # = your first SECRETS_KEY, never changed (keys the opt-out list)
# SECRETS_KEY_PREVIOUS=       # only while rotating SECRETS_KEY

# AI providers. Keys live only here (never in chat, logs or git). A provider without a key is
# disabled; with no key at all the rule-based mock assistant runs. Tenants allow Anthropic only
# unless their config says otherwise (ai.allowed_providers). See docs/PRIVACY.md before enabling others.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=     # paid tier only (the free tier may use data to improve Google products)
# XAI_API_KEY=

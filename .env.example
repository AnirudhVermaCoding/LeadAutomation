# Copy to .env (cp .env.example .env). Dev-only values — never reuse them in production.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres from docker-compose (owner role; M1 switches the app to a restricted role).
POSTGRES_PASSWORD=instantlead_dev
DATABASE_URL=postgres://instantlead:instantlead_dev@localhost:5432/instantlead

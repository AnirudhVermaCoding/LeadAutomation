# Automatic HTTPS (Let's Encrypt). The hostname comes from APP_DOMAIN in .env; point its DNS A record at the VPS.
{$APP_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy app:3000 {
		# While the app container restarts during a deploy (a few seconds), hold requests and retry
		# instead of answering 502: visitors see a slow page, not an error.
		lb_try_duration 20s
		lb_try_interval 500ms
		health_uri /readyz
		health_interval 10s
	}
}
